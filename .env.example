DEMO_MODE=true
COOKIE_SECURE=false
# Public address used for canonical links, Open Graph and sitemap.xml (e.g. https://campuspath.example.edu).
# Leave empty to use the address of each request.
PUBLIC_BASE_URL=
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/campuspath
# Install psycopg[binary] before selecting PostgreSQL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional semantic retrieval. Each database must use its own Qdrant collection.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=campuspath
# Optional speech providers; OpenAI-compatible endpoints.
SPEECH_BASE_URL=
SPEECH_API_KEY=
STT_MODEL=
TTS_MODEL=
TTS_VOICE=
OCR_LANGUAGE=eng

# Larger books: raise cautiously; accepted range 1–64 MiB.
MAX_UPLOAD_MIB=8
MAX_PDF_PAGES=1200
MAX_EXTRACTED_CHARS=5000000

# ---- Hosted deployment (0.6.0) -------------------------------------------------
# DATABASE_URL may be pasted exactly as Neon/Render/Supabase show it
# (postgres://... or postgresql://...); the driver is added automatically.
# Free AI example (Google Gemini, OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<your key from aistudio.google.com>
#   LLM_MODEL=<a current Gemini Flash model name>
# Free AI alternative (Groq): LLM_BASE_URL=https://api.groq.com/openai/v1
# Small requests + retries suit free AI plans.
LLM_EXCERPTS_PER_CALL=12
LLM_QUESTIONS_PER_CALL=6
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
# Files bigger than this are read in the background (avoids host timeouts).
BACKGROUND_UPLOAD_MIB=1.5
# Read scanned PDF pages with free OCR (needs tesseract + pdftoppm; included in Docker).
OCR_SCANNED_PDF=true
MAX_OCR_PAGES=60
# First accounts on a host without a shell. Delete the passwords after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEACHER_NAME=

# ---- Railway (0.7.0) -----------------------------------------------------------
# Railway sets PORT itself; do not add it. railway.json configures the Docker build,
# the /api/health check and restarts. Use DEMO_MODE=false and COOKIE_SECURE=true there.
# Free 1 GB PostgreSQL: Neon (direct connection string, pooling off) or Aiven.
# Optional free speech-to-text for the spoken viva (Groq Whisper):
#   SPEECH_BASE_URL=https://api.groq.com/openai/v1
#   SPEECH_API_KEY=<your key from console.groq.com>
#   STT_MODEL=whisper-large-v3-turbo
# Leave TTS_MODEL empty: the browser reads questions aloud for free.
